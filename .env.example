# Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# Django Settings (REQUIRED)
# ============================================
# Generate a new SECRET_KEY in production: python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-here-generate-a-new-one
# Set to False in production, True for development
DEBUG=True
# Comma-separated list of allowed hosts (e.g., localhost,127.0.0.1,your-domain.com,www.your-domain.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# Database Configuration (AWS RDS)
# ============================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=rubber_db
DB_USER=postgres
DB_PASSWORD=your-rds-database-password
DB_HOST=your-rds-endpoint.xxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379/0
USE_REDIS_CHANNELS=True

# ============================================
# AWS S3 Configuration
# ============================================
USE_S3=True
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your-secret-access-key-here
AWS_STORAGE_BUCKET_NAME=rubberedge-media
AWS_S3_REGION_NAME=us-east-1

# ============================================
# Twilio Configuration (Optional)
# ============================================
TWILIO_ENABLED=False
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================
# Celery Configuration
# ============================================
ENABLE_AUTO_SCRAPING=True

# ============================================
# CORS Configuration (Optional)
# ============================================
# Comma-separated list of allowed origins
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================
# Security Settings (Optional)
# ============================================
# Enable SSL redirect (only after SSL is configured)
SECURE_SSL_REDIRECT=False

# ============================================
# Notes:
# ============================================
# 1. Generate a new SECRET_KEY using:
#    python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
#
# 2. Get your RDS endpoint from AWS RDS Console
#
# 3. Get AWS credentials from IAM User you created for S3 access
#
# 4. Replace EC2 IP or domain name in ALLOWED_HOSTS
#
# 5. NEVER commit this file to git!
